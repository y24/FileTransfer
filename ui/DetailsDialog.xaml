<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="詳細" Width="440" Height="360" MinWidth="360" MinHeight="260"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="White" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo UI" FontSize="12.5"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="MessageText" Margin="18,14,18,10" TextWrapping="Wrap"/>
    <TextBox x:Name="LogBox" Grid.Row="1" Margin="18,0,18,14" IsReadOnly="True" TextWrapping="NoWrap"
             FontFamily="{StaticResource MonoFont}" FontSize="11.5" Background="#FAFAFA" BorderBrush="#E3E3E3"
             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
    <Border Grid.Row="2" Background="#F3F3F3" BorderBrush="#E3E3E3" BorderThickness="0,1,0,0" Padding="18,10">
      <Grid>
        <Button x:Name="OpenLogButton" Style="{StaticResource LinkButton}" Content="ログのフォルダを開く" HorizontalAlignment="Left"/>
        <Button x:Name="CloseButton" Style="{StaticResource StandardButton}" Content="閉じる" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" MinWidth="84"/>
      </Grid>
    </Border>
  </Grid>
</Window>
