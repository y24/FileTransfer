<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="White" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo UI" FontSize="12.5"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="18,14,18,16">
      <TextBlock Text="サーバーへの転送方法" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

      <RadioButton x:Name="SmbRadio" GroupName="Method" IsChecked="True">
        <TextBlock Text="SMB（ファイル共有）" FontWeight="SemiBold"/>
      </RadioButton>
      <TextBlock Margin="20,2,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12"
                 Text="\\サーバー\C$ などに robocopy で直接書き込みます。速い方法です。サーバーでファイル共有（445 番ポート）が有効になっている必要があります。"/>

      <RadioButton x:Name="WinRmRadio" GroupName="Method" Margin="0,12,0,0">
        <TextBlock Text="WinRM（PowerShell リモート）" FontWeight="SemiBold"/>
      </RadioButton>
      <TextBlock x:Name="WinRmText" Margin="20,2,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12"
                 Text="SMB で接続できないサーバー向けです。PowerShell リモート（5985 番ポート）でファイルを送ります。SMB より時間がかかります。フォルダはサーバー上のパス（C:\work など）で指定します。"/>

      <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{StaticResource FaintBrush}" FontSize="11.5"
                 Text="「このPC」への転送には影響しません。共有フォルダから読むときは、どちらの方法でもファイル共有を使います。"/>
    </StackPanel>
    <Border Grid.Row="1" Background="#F3F3F3" BorderBrush="#E3E3E3" BorderThickness="0,1,0,0" Padding="18,10">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CancelButton" Style="{StaticResource StandardButton}" Content="キャンセル" IsCancel="True" MinWidth="84" Margin="0,0,8,0"/>
        <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" Content="OK" IsDefault="True" MinWidth="84"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
