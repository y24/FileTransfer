<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileTransfer" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="White" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo UI" FontSize="12.5"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="18,14,18,16">
      <TextBlock x:Name="Heading" Text="送り先に同じ名前のファイルがあります" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"/>
      <TextBox x:Name="NameList" IsReadOnly="True" TextWrapping="NoWrap" MaxHeight="140"
               FontFamily="{StaticResource MonoFont}" FontSize="11.5" Background="#FAFAFA" BorderBrush="#E3E3E3" Padding="4,3"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
      <TextBlock x:Name="RenameNote" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
    </StackPanel>
    <Border Grid.Row="1" Background="#F3F3F3" BorderBrush="#E3E3E3" BorderThickness="0,1,0,0" Padding="18,10">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="OverwriteButton" Style="{StaticResource StandardButton}" Content="上書き" MinWidth="84" Margin="0,0,8,0"/>
        <Button x:Name="RenameButton" Style="{StaticResource PrimaryButton}" Content="名前を変えて送る" IsDefault="True" MinWidth="84" Margin="0,0,8,0"/>
        <Button x:Name="CancelButton" Style="{StaticResource StandardButton}" Content="キャンセル" IsCancel="True" MinWidth="84"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
